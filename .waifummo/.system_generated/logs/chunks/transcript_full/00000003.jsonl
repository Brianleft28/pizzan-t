{"step_index":205,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-05T18:08:45Z","content":"Created At: 2026-10-05T15:08:45-03:00\nCompleted At: 2026-10-05T15:08:45-03:00\nFile Path: `file:///C:/Users/Brian/Desktop/workspace/pizzant/src/recognizer.py`\nTotal Lines: 61\nTotal Bytes: 2291\nShowing lines 1 to 61\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import cv2\r\n2: import numpy as np\r\n3: import os\r\n4: import easyocr\r\n5: import warnings\r\n6: \r\n7: # Suprimir advertencias molestas de PyTorch sobre GPU y cuantización\r\n8: warnings.filterwarnings(\"ignore\", category=UserWarning)\r\n9: \r\n10: class PokéRecognizer:\r\n11:     def __init__(self, assets_path=\"assets\"):\r\n12:         self.assets_path = assets_path\r\n13:         # Inicializar explícitamente en CPU y silenciar el verbose de EasyOCR\r\n14:         self.reader = easyocr.Reader(['es', 'en'], gpu=False, verbose=False)\r\n15:         \r\n16:         # Template de estrella por si el OCR no lee bien el texto \"Shiny\"\r\n17:         self.shiny_star_tpl = self._load_template(\"shiny_star.png\")\r\n18:         # Template de estado Dormido\r\n19:         self.sleep_icon_tpl = self._load_template(\"status_sleep.png\")\r\n20: \r\n21:     def _load_template(self, name):\r\n22:         path = os.path.join(self.assets_path, name)\r\n23:         if os.path.exists(path):\r\n24:             return cv2.imread(path, 0)\r\n25:         return None\r\n26: \r\n27:     def check_status_sleep(self, img):\r\n28:         \"\"\"Compara el recorte con el icono de dormir guardado\"\"\"\r\n29:         if self.sleep_icon_tpl is None or img is None or img.size == 0:\r\n30:             return False\r\n31:         \r\n32:         gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\r\n33:         res = cv2.matchTemplate(gray, self.sleep_icon_tpl, cv2.TM_CCOEFF_NORMED)\r\n34:         return np.max(res) > 0.8\r\n35: \r\n36:     def analyze_slot(self, slot_img):\r\n37:         \"\"\"\r\n38:         Analiza el recorte de un nombre.\r\n39:         Retorna: { 'name': str, 'is_shiny': bool }\r\n40:         \"\"\"\r\n41:         if slot_img is None or slot_img.size == 0:\r\n42:             return {'name': \"\", 'is_shiny': False}\r\n43:             \r\n44:         gray = cv2.cvtColor(slot_img, cv2.COLOR_BGR2GRAY)\r\n45:         results = self.reader.readtext(gray)\r\n46:         \r\n47:         full_text = \" \".join([res[1] for res in results])\r\n48:         \r\n49:         # Detección de Shiny por texto\r\n50:         is_shiny = any(word in full_text.lower() for word in [\"shiny\", \"variocolor\", \"vário\", \"vã¡rio\", \"vã rico\"])\r\n51:         \r\n52:         # Respaldo por imagen (estrella)\r\n53:         if not is_shiny and self.shiny_star_tpl is not None:\r\n54:             res_s = cv2.matchTemplate(gray, self.shiny_star_tpl, cv2.TM_CCOEFF_NORMED)\r\n55:             if np.max(res_s) > 0.8: is_shiny = True\r\n56: \r\n57:         return {\r\n58:             'name': full_text,\r\n59:             'is_shiny': is_shiny\r\n60:         }\r\n61: \nThe above content shows the entire, complete file contents of the requested file.\n"}
