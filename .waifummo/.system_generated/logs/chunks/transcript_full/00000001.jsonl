cr_entry.get())'''\n            \nsave_new = '''            config[\"discord_webhook\"] = self.web_entry.get()\n            config[\"webhook_jwt\"] = self.jwt_entry.get()\n            config[\"ocr_retries\"] = int(self.ocr_entry.get())'''\n\ncontent = content.replace(save_old, save_new)\n\nwith open('main_gui.py', 'w', encoding='utf-8') as f:\n    f.write(content)\n","Description":"Refactorizando main_gui.py para agregar Webhook JWT","Overwrite":true,"TargetFile":"C:\\Users\\Brian\\Desktop\\workspace\\pizzant\\refactor_gui.py","toolAction":"Creating GUI refactor script","toolSummary":"Refactor script"}}]}
