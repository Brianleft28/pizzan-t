        if not self.bot.running: break\r\n33:             \r\n34:             # OPTIMIZACIÓN: Solo hacer OCR pesado 1 vez por segundo durante la caminata\r\n35:             current_time = time.time()\r\n36:             if current_time - last_ocr_check > 0.8:\r\n37:                 if self.bot.check_any_name_visible(self.observer.capture_frame()):\r\n38:                     self.log(\"HUD Detected! Stopping patrol.\", \"BRAIN\")\r\n39:                     break\r\n40:                 last_ocr_check = current_time\r\n41:                 \r\n42:             time.sleep(0.05)\r\n43:             \r\n44:         self.controller.key_up(direction)\r\n45:         time.sleep(random.uniform(0.1, 0.3)) # Micro-pausa humana\r\n46: \r\n47:     def _wait_for_menu(self, timeout=30):\r\n48:         \"\"\"Utilidad común para esperar a que el menú de batalla esté listo\"\"\"\r\n49:         start = time.time()\r\n50:         while (time.time() - start) < timeout:\r\n51:             if not self.bot.running: return False\r\n52:             if self.bot.is_menu_ready(self.observer.capture_frame()):\r\n53:                 return True\r\n54:             time.sleep(0.2)\r\n55:         return False\r\n56: \r\n57:     def _capture_sequence(self, target_name, is_shiny=False):\r\n58:         self.log(f\"━━━━━━━━━━ 🎯 CAPTURE: {target_name.upper()} ━━━━━━━━━━\", \"PHASE\")\r\n59:         if is_shiny:\r\n60:             self.log(f\"✨ ¡SHINY CONFIRMADO! Activando alarma...\", \"SUCCESS\")\r\n61:             self.bot.play_shiny_alarm()\r\n62:             \r\n63:         turn = 1\r\n64:         swiped = False\r\n65:         leppas = set()\r\n66:         captured = False\r\n67: \r\n68:         while self.bot.running:\r\n69:             self.bot.reset_activity_timer() \r\n70:             if not self._wait_for_menu(): break\r\n71:             \r\n72:             f_act = self.observer.capture_frame()\r\n73:             is_slp = self.bot.is_asleep(f_act)\r\n74:             is_low, hp_pct = self.bot.is_hp_low(f_act)\r\n75:             \r\n76:             # Decidir acción ANTES de loguear\r\n77:             mv_s = None\r\n78:             mv_n = \"\"\r\n79:             action_desc = \"\"\r\n80:             \r\n81:             if turn == 1:\r\n82:                 mv_s = self.config.get(\"ditto_key_attack\", \"2\")\r\n83:                 mv_n = self.config.get(\"ditto_name_attack\", \"Swipe\")\r\n84:                 action_desc = f\"⚔️ {mv_n} (Key {mv_s})\"\r\n85:             elif not is_slp:\r\n86:                 mv_s = self.config.get(\"ditto_key_sleep\", \"1\")\r\n87:                 mv_n = self.config.get(\"ditto_name_sleep\", \"Sleep\")\r\n88:                 action_desc = f\"💤 {mv_n} (Key {mv_s})\"\r\n89:             else:\r\n90:                 mv_n = \"Ball\"\r\n91:                 action_desc = f\"🟢 Throwing Ball\"\r\n92: \r\n93:             # Log estructurado del turno\r\n94:             hp_status = f\"LOW ({hp_pct:.0%})\" if (is_low or swiped) else f\"FULL ({hp_pct:.0%})\"\r\n95:             slp_status = \"💤 SLP\" if is_slp else \"👁️ AWK\"\r\n96:             self.log(f\"[T-{turn:02d}] HP: {hp_status} | {slp_status} | → {action_desc}\", \"BATTLE\")\r\n97: \r\n98:             if mv_s:\r\n99:                 self.controller.open_fight_menu()\r\n100:                 time.sleep(0.6)\r\n101:                 pp_curr, nr = self.bot.read_pp(mv_s, mv_n)\r\n102:                 \r\n103:                 if nr: \r\n104:                     leppas.add((mv_s, True))\r\n105:                     self.log(f\"[💊] PP for {mv_n} is {pp_curr}. Adding to restoration queue.\", \"HEAL\")\r\n106: \r\n107:                 if pp_curr == 0:\r\n108:                     self.log(f\"⚠️ {mv_n} has 0 PP! Switching to Ball.\", \"WARN\")\r\n109:                     mv_s = None\r\n110: \r\n111:                 if mv_s:\r\n112:                     self.controller.navigate_and_confirm_move(mv_s)\r\n113:                     if mv_n == self.config.get(\"ditto_name_attack\", \"Swipe\"):\r\n114:                         swiped = True\r\n115:                     time.sleep(2.0)\r\n116:                     while self.bot.is_menu_ready(self.observer.capture_frame()) and self.bot.running:\r\n117:                         time.sleep(0.5)\r\n118:             \r\n119:             if not mv_s:\r\n120:                 self.controller.use_ball(self.config.get(\"ditto_key_ball\", \"5\"))\r\n121:                 if self._check_capture_result():\r\n122:                     captured = True\r\n123:                     break\r\n124:             \r\n125:             turn += 1\r\n126: \r\n127:         # Resultado real de la captura\r\n128:         self.bot.encounters += 1\r\n129:         self.bot.save_progress()\r\n130:         \r\n131:         if captured:\r\n132:             self.log(f\"✅ CAPTURE CONFIRMED: {target_name.upper()} in {turn} turns!\", \"SUCCESS\")\r\n133:         else:\r\n134:             self.log(f\"❌ CAPTURE ENDED: {target_name.upper()} — {turn} turns (timeout/stop)\", \"WARN\")\r\n135:         \r\n136:         if is_shiny and captured:\r\n137:             self.log(\"✨ 🎉 ¡BRUTAL! ¡HAS ATRAPADO UN SHINY! ¡FELICIDADES! 🎉 ✨\", \"SUCCESS\")\r\n138:             self.bot.stop_shiny_alarm()\r\n139: \r\n140:         if leppas and self.config.get(\"auto_heal_pp\", True):\r\n141:             self.log(\"━━━━━━━━━━ 💊 HEALING ━━━━━━━━━━\", \"PHASE\")\r\n142:             leppa_wait = float(self.config.get(\"timing_leppa_wait\", 1.5))\r\n143:             self.log(f\"⏳ Waiting {leppa_wait}s for map to load before Leppa...\", \"HEAL\")\r\n144:             time.sleep(leppa_wait)\r\n145:             self.bot.reset_activity_timer()\r\n146:             self.log(f\"Restoring {len(leppas)} move(s) from PP queue...\", \"HEAL\")\r\n147:             for slot_data in list(leppas):\r\n148:                 self.controller.use_leppa_sequence_single(self.config.get(\"ditto_key_leppa\", \"4\"), slot_data[0], slot_data[1])\r\n149:                 time.sleep(1.0)\r\n150: \r\n151:         # Limpieza final por si quedó algún diálogo abierto\r\n152:         time.sleep(0.5)\r\n153:         self.controller._press('x')\r\n154:         self.controller._press('z')\r\n155:         time.sleep(0.3)\r\n156:         self.controller._press('x')\r\n157:         self.log(f\"━━━━━━━━━━ END CAPTURE ━━━━━━━━━━\", \"PHASE\")\r\n158: \r\n159:     def _check_capture_result(self):\r\n160:         \"\"\"\r\n161:         Espera el resultado de la Pokébola con spamming activo de la interfaz para evitar UI overlap.\r\n162:         \"\"\"\r\n163:         ball_wait   = float(self.config.get(\"timing_ball_wait\", 0.5))\r\n164:         settle_time = float(self.config.get(\"timing_capture_settle\", 2.5))\r\n165: \r\n166:         self.log(f\"⏳ Waiting {ball_wait}s for ball animation...\", \"DEBUG\")\r\n167:         time.sleep(ball_wait)\r\n168: \r\n169:         for _ in range(60):\r\n170:             if not self.bot.running:\r\n171:                 return False\r\n172:                 \r\n173:             # ACTIVE POLLING: Destruimos ventanas emergentes de stats para que el OCR pueda ver el \"CAUGHT\"\r\n174:             self.controller._press('left', duration=0.02)\r\n175:             self.controller._press('x', duration=0.02)\r\n176:             self.controller._press('right', duration=0.02)\r\n177:             self.controller._press('x', duration=0.02)\r\n178:             \r\n179:             # Recién ahora tomamos captura, con el texto presumiblemente limpio\r\n180:             fb = self.observer.capture_frame()\r\n181:             m = self.bot.check_msg_area(fb)\r\n182: \r\n183:             if m == \"SUCCESS\":\r\n184:                 self.log(\"🎉 Message read: CAUGHT!\", \"SUCCESS\")\r\n185:                 time.sleep(settle_time)\r\n186:                 # Cerrar diálogos adicionales\r\n187:                 for _ in range(8):\r\n188:                     self.controller._press('z', duration=0.05)\r\n189:                     self.controller._press('x', duration=0.05)\r\n190:                     time.sleep(0.3)\r\n191:                 return True\r\n192: \r\n193:             if m == \"FAILURE\":\r\n194:                 self.log(\"💨 Ball broke free — retrying next turn.\", \"WARN\")\r\n195:                 time.sleep(1.5)\r\n196:                 return False\r\n197: \r\n198:             if self.bot.is_menu_ready(fb):\r\n199:                 return False\r\n200: \r\n201:             time.sleep(0.1) # Agilizamos el poll\r\n202: \r\n203:         # TIMEOUT FIX: Si el loop terminó y no volvió el menú de batalla, deducimos captura\r\n204:         self.log(\"⏱️ No battle menu returned. Assuming CAUGHT due to UI overlap!\", \"SUCCESS\")\r\n205:         return True\r\n206: \r\n207: \nThe above content shows the entire, complete file contents of the requested file.\n"}
