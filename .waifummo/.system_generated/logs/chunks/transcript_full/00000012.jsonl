1}]: '{txt}'\", \"DEBUG\")\n            nums = re.findall(r'(\\d+)', txt)\n            if len(nums) >= 2:\n                self.reset_activity_timer() # Éxito en lectura = actividad\n                curr, total = int(nums[0]), int(nums[1])\n                return (total - curr >= 60), f\"{curr}/{total}\", (total - curr)\n            time.sleep(0.3)\n        return False, \"??/??\", 0","TargetFile":"C:\\Users\\Brian\\Desktop\\workspace\\pizzant\\src\\bot_main.py","toolAction":"Removing read_hunter_hp","toolSummary":"Remove read_hunter_hp"}}]}
